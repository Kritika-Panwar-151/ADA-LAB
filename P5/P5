
#include<stdio.h>
#include<time.h>
#include<stdlib.h>
void heapify(int H[],int n){
    for(int i=n/2;i>=1;i--){
        int k=i;
        int v=H[i];
        int heap=0;
        while(heap==0 && 2*k<=n){
            int j=2*k;
            if(j<n && H[j]<H[j+1])
                j=j+1;
            if(v>=H[j])
                heap=1;
            else{
                H[k]=H[j];
                k=j;
            }
        }
        H[k]=v;
    }
}
void heapSort(int H[],int n){
    heapify(H,n);
    for(int i=n;i>=2;i--){
        int temp=H[1];
        H[1]=H[i];
        H[i]=temp;
        int k=1;
        int v=H[1];
        while(2*k<=i-1){
            int j=2*k;
            if(j<i-1 && H[j]<H[j+1])
                j=j+1;
            if(v>=H[j])
                break;
            H[k]=H[j];
            k=j;
        }
        H[k]=v;
    }
}
void main(){
    int n;
    printf("Enter number of elements:");
    scanf("%d",&n);
    int H[n+1];
    printf("Enter the elements:\n");
    for(int i=1;i<=n;i++){
        scanf("%d",&H[i]);
    }
    clock_t start=clock();
    heapSort(H,n);
    clock_t end=clock();
    double cpu_time_used=(((double)(end-start))/CLOCKS_PER_SEC)*1000.0;
    printf("\nElements after heap sort:");
    for(int i=1;i<=n;i++){
        printf("%d ",H[i]);
    }
    printf("\nInput Size:%d Execution Time:%.5f",n,cpu_time_used);
}
