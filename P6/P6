#include<stdio.h>
int max(int a,int b){
    return (a>b)?a:b;
}
void main(){
    int n,m;
    printf("Enter the number of objects and capacity:");
    scanf("%d %d",&n,&m);
    int v[n+1][m+1];
    int p[n+1],w[n+1],x[n+1];
    printf("Enter the weight and profit:\n");
    for(int i=1;i<=n;i++){
        scanf("%d %d",&w[i],&p[i]);
    }
    for(int i=0;i<=n;i++){
        x[i]=0;
    }
    for(int i=0;i<=n;i++){
        for(int j=0;j<=m;j++){
            if(i==0 || j==0) v[i][j]=0;
            else if(w[i]<=j) v[i][j]=max(v[i-1][j],p[i]+v[i-1][j-w[i]]);
            else v[i][j]=v[i-1][j];
        }
    }
    int i=n;
    int j=m;
    while(i>0 && j>0){
        if(v[i][j]!=v[i-1][j]){
            x[i]=1;
            j=j-w[i];
        }
        i=i-1;
    }
    printf("Selected objects weight and profit:\n");
    printf("%-5s %-5s","w","p");
    for(int i=0;i<=n;i++){
        if(x[i]==1) printf("\n%-5d %-5d",w[i],p[i]);
    }
    printf("\nTotal profit:%d",v[n][m]);
}
