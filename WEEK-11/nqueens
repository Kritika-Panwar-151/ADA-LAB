#include<stdio.h>
#include<stdlib.h>
int x[20];
int place(int k,int i);
void nqueens(int k,int n)
{
    for(int i=1;i<=n;i++)
    {
        if(place(k,i))
        {
            x[k]=i;
            if(k==n)
            {
                for(int j=1;j<=n;j++)
                {
                    printf("\nRow:%d,Coloumn:%d",j,x[j]);

                }
                printf("\n");

            }
            else{
                nqueens(k+1,n);
            }
        }
    }
}
int place(int k,int i)
{
    for(int j=1;j<k;j++)
    {
        if(x[j]==i || (abs(j-k)==abs(x[j]-i))) return 0;
    }
    return 1;
}
void main()
{
    int n;
    printf("Enter number of queens:");
    scanf("%d",&n);
    nqueens(1,n);
}
