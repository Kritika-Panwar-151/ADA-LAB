#include<stdio.h>
#include<time.h>
#include<stdlib.h>
void heapify(int H[],int n)
{
    for(int i=n/2;i>=1;i--)
    {
        int k=i;
        int v=H[i];
        int heap=0;
        while(heap==0 && 2*k<=n)
        {
            int j=2*k;
            if(j<n && H[j]<H[j+1]) j=j+1;
            if(v>=H[j]) heap=1;
            else
            {
                H[k]=H[j];
                k=j;
            }
        }
        H[k]=v;
    }
}
void heapSort(int H[],int n)
{
    heapify(H,n);
    for(int i=n;i>=2;i--)
    {
        int temp=H[1];
        H[1]=H[i];
        H[i]=temp;
        heapify(H,i-1);
    }
}
