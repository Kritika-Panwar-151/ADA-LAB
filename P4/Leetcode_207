#include <stdlib.h>
int* sortedSquares(int* nums, int numsSize, int* returnSize) {
    int* res = (int*)malloc(sizeof(int) * numsSize);
    int i = 0;
    int j = numsSize - 1;
    int k = numsSize - 1;
    while (i <= j) {
        int left = nums[i] * nums[i];
        int right = nums[j] * nums[j];
        if (left > right) {
            res[k--] = left;
            i++;
        } else {
            res[k--] = right;
            j--;
        }
    }
    *returnSize = numsSize;
    return res;
}

